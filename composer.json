{
    "name": "ratespecial/laravel-spyhole",
    "description": "Laravel package to record and re-watch user sessions",
    "keywords": [
        "laravel-spyhole"
    ],
    "homepage": "https://github.com/ratespecial/laravel-spyhole",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Andrea Bondì",
            "email": "me@kalizi.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-zlib": "*",
        "illuminate/support": ">=12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ratespecial\\LaravelSpyhole\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ratespecial\\LaravelSpyhole\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ratespecial\\LaravelSpyhole\\LaravelSpyholeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ]
    }
}
